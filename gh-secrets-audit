#!/usr/bin/env python3
"""gh secrets-audit: find GitHub Actions secrets and variables that are missing or unused.

Compares the names your workflows reference (secrets.X, vars.X) with the names defined
for the repository, its environments, its organization and Dependabot. Read-only.
GitHub's API only ever returns names, never secret values.
"""

from __future__ import annotations

import argparse
import base64
import json
import re
import subprocess
import sys
from dataclasses import dataclass, field
from pathlib import Path

__version__ = "0.2.0"

BUILT_IN = {"GITHUB_TOKEN"}
_REF = re.compile(
    r"\b(secrets|vars)\s*(?:\.\s*([A-Za-z_][A-Za-z0-9_-]*)|\[\s*['\"]([A-Za-z_][A-Za-z0-9_-]*)['\"]\s*\])"
)


class AuditError(Exception):
    pass


@dataclass(frozen=True)
class Ref:
    kind: str  # "secret" or "variable"
    name: str
    file: str
    line: int


@dataclass
class Defined:
    """Names defined for the repository, by where they come from."""

    sources: dict[tuple[str, str], set[str]] = field(default_factory=dict)  # (kind, name) -> {"repo", ...}
    unreadable: list[str] = field(default_factory=list)

    def add(self, kind: str, name: str, source: str) -> None:
        self.sources.setdefault((kind, name.upper()), set()).add(source)

    def has(self, kind: str, name: str) -> bool:
        return (kind, name.upper()) in self.sources


# ---------------------------------------------------------------- workflows


def _workflow_call_secrets(lines: list[str]) -> set[str]:
    """Names declared under `on: workflow_call: secrets:`. Those come from the caller, not the repo."""
    declared: set[str] = set()
    for i, line in enumerate(lines):
        if not re.match(r"^\s*workflow_call\s*:", line):
            continue
        base = len(line) - len(line.lstrip())
        secrets_indent: int | None = None  # indentation of the `secrets:` key
        child_indent: int | None = None  # indentation of the names listed under it
        for follow in lines[i + 1 :]:
            if not follow.strip() or follow.lstrip().startswith("#"):
                continue
            indent = len(follow) - len(follow.lstrip())
            if indent <= base:
                break
            if secrets_indent is not None and indent <= secrets_indent:
                secrets_indent = child_indent = None
            if secrets_indent is None:
                if re.match(r"^\s*secrets\s*:\s*$", follow):
                    secrets_indent = indent
                continue
            if child_indent is None:
                child_indent = indent
            key = re.match(r"^\s*([A-Za-z_][A-Za-z0-9_-]*)\s*:", follow)
            if key and indent == child_indent:
                declared.add(key.group(1).upper())
    return declared


def scan_workflow(text: str, file: str) -> list[Ref]:
    lines = text.splitlines()
    passed_in = _workflow_call_secrets(lines)
    refs = []
    for number, line in enumerate(lines, start=1):
        if line.lstrip().startswith("#"):
            continue
        for match in _REF.finditer(line):
            kind = "secret" if match.group(1) == "secrets" else "variable"
            name = (match.group(2) or match.group(3)).upper()
            if kind == "secret" and (name in BUILT_IN or name in passed_in):
                continue
            refs.append(Ref(kind, name, file, number))
    return refs


def local_workflows(root: Path) -> dict[str, str]:
    folder = root / ".github" / "workflows"
    files = sorted(list(folder.glob("*.yml")) + list(folder.glob("*.yaml")))
    return {f.name: f.read_text(encoding="utf-8", errors="replace") for f in files}


# ---------------------------------------------------------------- GitHub API


class GitHub:
    def __init__(self, repo: str):
        self.repo = repo

    def _api(self, path: str, jq: str, paginate: bool = True) -> list[str] | None:
        args = ["gh", "api", "-H", "Accept: application/vnd.github+json", path, "--jq", jq]
        if paginate:
            args.insert(2, "--paginate")
        try:
            result = subprocess.run(args, capture_output=True, text=True, check=False)
        except FileNotFoundError:
            raise AuditError("the GitHub CLI (gh) is not installed") from None
        if result.returncode != 0:
            if re.search(r"HTTP 40[34]", result.stderr):
                return None  # no access
            if "HTTP 422" in result.stderr:
                return []  # not applicable, e.g. organization secrets on a personal repo
            raise AuditError(result.stderr.strip() or f"gh api {path} failed")
        return [line for line in result.stdout.splitlines() if line.strip()]

    def names(self, path: str, key: str) -> list[str] | None:
        return self._api(path, f".{key}[].name")

    def environments(self) -> list[str] | None:
        return self._api(f"repos/{self.repo}/environments", ".environments[].name")

    def remote_workflows(self) -> dict[str, str]:
        listing = self._api(
            f"repos/{self.repo}/contents/.github/workflows",
            '.[] | select(.type == "file") | .name',
            paginate=False,
        )
        out = {}
        for name in listing or []:
            if not name.endswith((".yml", ".yaml")):
                continue
            content = self._api(f"repos/{self.repo}/contents/.github/workflows/{name}", ".content", False)
            if content:
                out[name] = base64.b64decode("".join(content)).decode("utf-8", "replace")
        return out


def collect_defined(api: GitHub) -> Defined:
    defined = Defined()
    repo = api.repo
    sources = [
        ("secret", "repo", f"repos/{repo}/actions/secrets", "secrets"),
        ("variable", "repo", f"repos/{repo}/actions/variables", "variables"),
        ("secret", "organization", f"repos/{repo}/actions/organization-secrets", "secrets"),
        ("variable", "organization", f"repos/{repo}/actions/organization-variables", "variables"),
        ("secret", "dependabot", f"repos/{repo}/dependabot/secrets", "secrets"),
    ]
    for kind, source, path, key in sources:
        names = api.names(path, key)
        if names is None:
            defined.unreadable.append(f"{source} {kind}s")
            continue
        for name in names:
            defined.add(kind, name, source)

    envs = api.environments()
    if envs is None:
        defined.unreadable.append("environments")
        envs = []
    for env in envs:
        safe = env.replace("/", "%2F")
        for kind, path, key in (
            ("secret", f"repos/{repo}/environments/{safe}/secrets", "secrets"),
            ("variable", f"repos/{repo}/environments/{safe}/variables", "variables"),
        ):
            names = api.names(path, key)
            if names is None:
                defined.unreadable.append(f"environment '{env}' {kind}s")
                continue
            for name in names:
                defined.add(kind, name, f"environment: {env}")
    return defined


# ---------------------------------------------------------------- report


@dataclass
class Result:
    missing: dict[tuple[str, str], list[Ref]]
    unused: dict[tuple[str, str], set[str]]
    used: int
    unreadable: list[str]


def audit(refs: list[Ref], defined: Defined) -> Result:
    by_name: dict[tuple[str, str], list[Ref]] = {}
    for ref in refs:
        by_name.setdefault((ref.kind, ref.name), []).append(ref)
    missing = {key: found for key, found in sorted(by_name.items()) if not defined.has(*key)}
    unused = {
        key: where - {"organization"}
        for key, where in sorted(defined.sources.items())
        if key not in by_name
        and where - {"organization"}  # org-wide names are shared, not this repo's clutter
    }
    used = sum(1 for key in by_name if defined.has(*key))
    return Result(missing, unused, used, defined.unreadable)


def _locations(refs: list[Ref], limit: int = 3) -> str:
    places = []
    for ref in refs:
        place = f"{ref.file}:{ref.line}"
        if place not in places:
            places.append(place)
    shown = ", ".join(places[:limit])
    return shown + (f" (+{len(places) - limit} more)" if len(places) > limit else "")


def render(result: Result, repo: str) -> str:
    out = []
    if result.missing:
        width = max(len(name) for _, name in result.missing)
        out.append("Missing: used in workflows but not defined")
        for (kind, name), refs in result.missing.items():
            out.append(f"  {name:<{width}}  {kind:<8}  {_locations(refs)}")
        out.append("")
    if result.unused:
        width = max(len(name) for _, name in result.unused)
        out.append("Unused: defined but not referenced by any workflow")
        for (kind, name), where in result.unused.items():
            out.append(f"  {name:<{width}}  {kind:<8}  {', '.join(sorted(where))}")
        out.append("")
    if not result.missing and not result.unused:
        out.append(
            f"All good: every secret and variable used in {repo}'s workflows is defined, and none are unused."
        )
    else:
        out.append(
            f"{len(result.missing)} missing, {len(result.unused)} unused, {result.used} in use and defined."
        )
    if result.unreadable:
        out.append(
            f"\nCouldn't read: {', '.join(result.unreadable)}. That usually needs admin access to the repo."
        )
    return "\n".join(out)


def _cell(text: str) -> str:
    return text.replace("|", "\\|")


def as_markdown(result: Result, repo: str) -> str:
    out = [f"### Secrets audit: {repo}", ""]
    if result.missing:
        out += ["**Missing:** used in workflows but not defined", ""]
        out += ["| Name | Kind | Used in |", "| --- | --- | --- |"]
        for (kind, name), refs in result.missing.items():
            out.append(f"| `{name}` | {kind} | {_cell(_locations(refs))} |")
        out.append("")
    if result.unused:
        out += ["**Unused:** defined but not referenced by any workflow", ""]
        out += ["| Name | Kind | Defined in |", "| --- | --- | --- |"]
        for (kind, name), where in result.unused.items():
            out.append(f"| `{name}` | {kind} | {_cell(', '.join(sorted(where)))} |")
        out.append("")
    if not result.missing and not result.unused:
        out.append("All good: every secret and variable used is defined, and none are unused.")
    else:
        out.append(
            f"{len(result.missing)} missing, {len(result.unused)} unused, {result.used} in use and defined."
        )
    if result.unreadable:
        out += ["", f"Couldn't read: {', '.join(result.unreadable)}."]
    return "\n".join(out)


def as_json(result: Result) -> str:
    return json.dumps(
        {
            "missing": [
                {"kind": k, "name": n, "references": [f"{r.file}:{r.line}" for r in refs]}
                for (k, n), refs in result.missing.items()
            ],
            "unused": [
                {"kind": k, "name": n, "defined_in": sorted(w)} for (k, n), w in result.unused.items()
            ],
            "in_use": result.used,
            "unreadable": result.unreadable,
        },
        indent=2,
    )


def _current_repo() -> str:
    try:
        result = subprocess.run(
            ["gh", "repo", "view", "--json", "nameWithOwner", "--jq", ".nameWithOwner"],
            capture_output=True,
            text=True,
            check=False,
        )
    except FileNotFoundError:
        raise AuditError("the GitHub CLI (gh) is not installed") from None
    if result.returncode != 0 or not result.stdout.strip():
        raise AuditError("not inside a GitHub repository. Run it in a clone, or pass -R owner/repo")
    return result.stdout.strip()


def _git_root() -> Path | None:
    result = subprocess.run(
        ["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True, check=False
    )
    return Path(result.stdout.strip()) if result.returncode == 0 else None


def main(argv: list[str] | None = None, api_factory=GitHub) -> int:
    parser = argparse.ArgumentParser(
        prog="gh secrets-audit",
        description="Find GitHub Actions secrets and variables that are missing or unused.",
    )
    parser.add_argument("-R", "--repo", metavar="OWNER/REPO", help="repository to audit (default: current)")
    parser.add_argument(
        "--remote", action="store_true", help="read workflows from GitHub, not the local clone"
    )
    output = parser.add_mutually_exclusive_group()
    output.add_argument("--json", action="store_true", help="print JSON")
    output.add_argument("--markdown", action="store_true", help="print Markdown, for pasting into an issue")
    parser.add_argument(
        "--fail-on-unused", action="store_true", help="exit with status 1 if anything is unused"
    )
    parser.add_argument("--version", action="version", version=f"gh-secrets-audit {__version__}")
    args = parser.parse_args(argv)

    try:
        repo = args.repo or _current_repo()
        api = api_factory(repo)
        root = None if (args.remote or args.repo) else _git_root()
        workflows = local_workflows(root) if root else api.remote_workflows()
        if not workflows:
            print(f"No workflow files found in {'.github/workflows' if root else repo}.")
            return 0
        refs = [ref for name, text in workflows.items() for ref in scan_workflow(text, name)]
        defined = collect_defined(api)
        if {"repo secrets", "repo variables"} <= set(defined.unreadable):
            raise AuditError(
                f"can't list the secrets of {repo}. Listing secret names needs admin access to the repository"
            )
        result = audit(refs, defined)
    except AuditError as exc:
        print(f"gh secrets-audit: {exc}", file=sys.stderr)
        return 2

    if args.json:
        print(as_json(result))
    elif args.markdown:
        print(as_markdown(result, repo))
    else:
        print(render(result, repo))
    if result.missing or (args.fail_on_unused and result.unused):
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
